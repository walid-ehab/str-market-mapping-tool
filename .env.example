VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — enables the "OpenStreetMap" basemap style (Stadia Maps' OSM Bright). Get a free key
# at https://stadiamaps.com. Leave unset to just not offer that style; everything else works fine.
VITE_STADIA_API_KEY=your-stadia-maps-api-key
